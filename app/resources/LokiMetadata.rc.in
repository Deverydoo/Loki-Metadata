#include <winver.h>

// Qt uses IDI_ICON1 as the windows' icon too.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/LokiMetadata.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Chaos Rift Entertainment, LLC"
            VALUE "FileDescription", "Loki Metadata"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "LokiMetadata"
            VALUE "LegalCopyright", "Copyright 2026 Chaos Rift Entertainment, LLC. Apache License 2.0."
            VALUE "OriginalFilename", "LokiMetadata.exe"
            VALUE "ProductName", "Loki Metadata"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
